NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://sahay:sahay2026@localhost:5432/sahay_dev?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379

# Dev CORS (see .env.dev) — comma-separated ports or full origins
# CORS_ORIGINS=3000,59012

# Auth (defaults exist for local non-production; override in production)
# JWT_ACCESS_SECRET=qSeNwX2S7CMcQ98HPf4/S1AXMlj2DsNwYQ3uH+47t3jLK6JOIZqsUPIfxsYMA1PG
# JWT_REFRESH_SECRET=G0w821u2HXnQr40R7YK16g6m21qX98o3N6zL5xQ4w3U2s1R0p9n8m7k6j5h4g3f2e1d0c
# OTP_PEPPER=mMCG8xxorpyBvW/AChCP8XSyhNpNMdWo

# OTP delivery: console | msg91 | stub  (SMS default: console)
OTP_SMS_PROVIDER=console
# OTP email: console | resend
OTP_EMAIL_PROVIDER=console
# Log OTP codes to the server log (never JSON). Non-production only.
OTP_DEV_LOG=true

# MSG91 (required when OTP_SMS_PROVIDER=msg91)
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_OTP_VAR=otp

# Resend (required when OTP_EMAIL_PROVIDER=resend)
# RESEND_API_KEY=
# OTP_EMAIL_FROM="SAHAY <noreply@your-verified-domain>"

# Native ID token audiences (comma-separated)
# GOOGLE_CLIENT_IDS=
# APPLE_CLIENT_IDS=

#Google Maps API Key
#GOOGLE_MAPS_API_KEY=
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  NEWS
  GOVERNMENT
  MUNICIPAL
  TRAFFIC
  WEATHER
  SOCIAL
  CITIZEN
}

enum IngestMethod {
  RSS
  API
  WEBHOOK
  SCRAPE
}

enum ArticleTopicSource {
  FEED_CATEGORY
  EXTRACTED
  MANUAL
}

enum ContentType {
  NEWS_ARTICLE
  CIVIC_ISSUE
  ALERT
}

enum ContentStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
  FLAGGED
}

enum AuthProvider {
  GOOGLE
  APPLE
  PHONE
  EMAIL
}

model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
}

model AuthIdentity {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AuthProvider
  providerSubject String
  createdAt       DateTime     @default(now())

  @@unique([provider, providerSubject])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  deviceId  String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Publisher (one row per outlet). Pollable endpoints live on SourceFeed.
model Source {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  type        SourceType
  homepageUrl String
  trustTier   Int        @default(2) // 1 = official/govt, 2 = established outlet, 3 = aggregator/blog
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  feeds    SourceFeed[]
  articles Article[]
}

model SourceFeed {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id])

  url          String       @unique
  ingestMethod IngestMethod @default(RSS)
  language     String       @default("en")

  categoryId       String?
  category         NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  rawCategoryLabel String?

  fetchIntervalSeconds Int       @default(900)
  lastFetchedAt        DateTime?
  lastEtag             String?
  lastModifiedHeader   String?

  isActive            Boolean @default(true)
  consecutiveFailures Int     @default(0)
  lastStatus          String?
  lastError           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rawArticles RawArticle[]

  @@index([isActive, fetchIntervalSeconds])
}

// TODO(R6): rename to Category when civic issues and alerts land.
model NewsCategory {
  id       String         @id @default(cuid())
  name     String
  slug     String         @unique
  parentId String?
  parent   NewsCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children NewsCategory[] @relation("CategoryHierarchy")

  feeds        SourceFeed[]
  contentItems ContentItem[]
}

// SAHAY-controlled interest taxonomy (not publisher section labels).
model Topic {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String // English display; locale translations can be added later
  parentId String?
  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Topic[] @relation("TopicHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articleTopics ArticleTopic[]
}

model ArticleTopic {
  id        String             @id @default(cuid())
  articleId String
  article   Article            @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  source    ArticleTopicSource @default(FEED_CATEGORY)
  confidence Float?

  createdAt DateTime @default(now())

  @@unique([articleId, topicId])
  @@index([topicId, articleId])
}

// Immutable ingest snapshot. After insert, only processing metadata may change.
model RawArticle {
  id              String     @id @default(cuid())
  sourceFeedId    String
  sourceFeed      SourceFeed @relation(fields: [sourceFeedId], references: [id])
  externalId      String
  payload         Json
  fetchedAt       DateTime   @default(now())
  processed       Boolean    @default(false)
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  article Article?

  @@unique([sourceFeedId, externalId])
  @@index([processed])
  @@index([sourceFeedId, fetchedAt])
}

model ContentItem {
  id       String        @id @default(cuid())
  type     ContentType   @default(NEWS_ARTICLE)
  status   ContentStatus @default(PUBLISHED)

  title   String
  summary String?

  language           String    @default("en")
  languageConfidence Float?
  publishedAt        DateTime?

  categoryId String?
  category   NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  entities   Json?
  urgency    String?
  confidence Float?

  titleFingerprint   String?
  canonicalContentId String?
  canonicalContent   ContentItem?  @relation("ContentDuplicates", fields: [canonicalContentId], references: [id], onDelete: SetNull)
  duplicates         ContentItem[] @relation("ContentDuplicates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article?

  @@index([status, type, publishedAt])
  @@index([categoryId])
  @@index([titleFingerprint, publishedAt])
  @@index([canonicalContentId])
}

model Article {
  id            String      @id @default(cuid())
  contentItemId String      @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  rawArticleId String     @unique
  rawArticle   RawArticle @relation(fields: [rawArticleId], references: [id])
  sourceId     String
  source       Source     @relation(fields: [sourceId], references: [id])

  url       String
  imageUrl  String?
  fetchedAt DateTime @default(now())

  articleTopics ArticleTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
}
